# Generated by the @local/dsh-wrainrock-daemon plugin — rewritten whenever it installs.
[Unit]
Description=DeepSeek Harness (web) — autostart and crash supervision
@@CONDITION@@
After=network-online.target
Wants=network-online.target
# If the supervisor itself keeps dying, systemd gives up and the safe-mode unit
# takes over (it boots the pristine safe profile and reports the incident).
StartLimitIntervalSec=90
StartLimitBurst=5
OnFailure=@@SAFE_UNIT@@

[Service]
Type=simple
ExecStart=@@SUPERVISOR_EXEC@@
Restart=on-failure
RestartSec=3
RestartSteps=5
RestartMaxDelaySec=60
TimeoutStopSec=30
KillMode=control-group
Slice=app.slice
SyslogIdentifier=dsh-wrainrock-daemon
StandardOutput=journal
StandardError=journal
Environment=@@ENV_DSH_HOME@@
Environment=@@ENV_PATH@@

[Install]
WantedBy=default.target
